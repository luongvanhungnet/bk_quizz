APP_NAME=BKQuiz RAG Service
APP_ENV=development
APP_BUILD_REVISION=development
APP_HOST=127.0.0.1
APP_PORT=8090

# Bắt buộc khi gọi Gemini. Không đặt key trực tiếp trong script hoặc commit vào Git.
# Development từ chối khởi động nếu process và file .env chứa hai key khác nhau.
GEMINI_API_KEY=
GEMINI_API_BASE_URL=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=32768
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_ATTEMPTS=3
# Số lần retry sau lần gọi đầu. Nếu đặt, biến này ưu tiên GEMINI_MAX_ATTEMPTS.
GEMINI_MAX_RETRIES=3
GEMINI_MAX_CONCURRENCY=2
GEMINI_RETRY_INITIAL_DELAY_SECONDS=1

# Chuỗi fallback chỉ dùng cho sinh quiz: API key -> OAuth ADC -> Ollama.
LLM_FALLBACK_ENABLED=true
GEMINI_OAUTH_ENABLED=true
GEMINI_OAUTH_MODEL=gemini-3.6-flash
GEMINI_OAUTH_QUOTA_PROJECT=gen-lang-client-0839815713
GEMINI_OAUTH_TIMEOUT_SECONDS=120
GEMINI_BATCH_SIZE=10
MATH_VISION_ENABLED=true
MATH_VISION_MODEL=gemini-3.5-flash-lite
MATH_VISION_TIMEOUT_SECONDS=60
MATH_EXTRACTION_VERSION=pdf-math-v1

OLLAMA_ENABLED=true
# Chạy trực tiếp Windows: 127.0.0.1. Trong Docker dùng host.docker.internal.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_CONTEXT_SIZE=4096
OLLAMA_MAX_OUTPUT_TOKENS=2400
OLLAMA_TEMPERATURE=0.1
OLLAMA_KEEP_ALIVE=60s
OLLAMA_MAX_QUESTIONS_PER_CALL=2
OLLAMA_BATCH_MAX_RETRIES=1

LLM_CIRCUIT_BREAKER_FAILURE_THRESHOLD=1
LLM_CIRCUIT_BREAKER_COOLDOWN_SECONDS=300

# Bắt buộc. Spring Boot phải gửi cùng giá trị trong X-Internal-API-Key.
SPRING_BOOT_INTERNAL_API_KEY=change-me-with-a-long-random-secret
SPRING_BOOT_PREVIOUS_INTERNAL_API_KEY=

# Redis dùng cho Celery, rate limit và distributed index lock.
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=1
REDIS_SOCKET_TIMEOUT_SECONDS=2
INDEX_LOCK_MODE=auto
INDEX_LOCK_FALLBACK_COOLDOWN_SECONDS=30
CELERY_QUEUE=rag-indexing
CELERY_WORKER_POOL=solo
CELERY_WORKER_CONCURRENCY=1
CELERY_WORKER_HEARTBEAT_KEY=rag:worker:heartbeat
CELERY_WORKER_HEARTBEAT_INTERVAL_SECONDS=10
CELERY_WORKER_HEARTBEAT_TTL_SECONDS=30
PENDING_JOB_RECONCILE_SECONDS=30
INDEXING_JOB_MAX_ATTEMPTS=4
INDEXING_JOB_STALE_SECONDS=300
GEMINI_GLOBAL_RPM=10
GEMINI_USER_RPM=5
ASK_USER_RPM=20
UPLOAD_USER_RPM=5
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_OPEN_SECONDS=60
MINIMUM_FREE_DISK_MB=256
RAG_LOW_MEMORY_MODE=true
WORKER_MODEL_IDLE_SECONDS=60

# RAG tài liệu hệ thống (embedding chạy local, không dùng quota Gemini)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BACKEND=onnx
EMBEDDING_PRECISION=int8
EMBEDDING_ONNX_MODEL_PATH=data/models/embedding-onnx
RAG_PRELOAD_EMBEDDING=true
RAG_CPU_THREADS=2
SYSTEM_DOCUMENTS_DIR=data/system-documents
SYSTEM_INDEX_DIR=data/indexes/system
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200
RAG_DEFAULT_TOP_K=5
RAG_MAX_TOP_K=10
RAG_MIN_SCORE=0.25
HYBRID_ENABLED=true
QUERY_REWRITE_ENABLED=true
HYBRID_VECTOR_CANDIDATES=30
HYBRID_BM25_CANDIDATES=30
HYBRID_RRF_K=60
RERANKER_ENABLED=true

RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANK_CANDIDATES=20
RERANK_MIN_CANDIDATES=3
RAG_MAX_CONTEXT_CHARS=16000
CITATION_MATCH_MODE=semantic
CITATION_LEXICAL_MIN_SCORE=0.82
CITATION_SEMANTIC_SAME_SOURCE_MIN_SCORE=0.72
CITATION_SEMANTIC_CROSS_SOURCE_MIN_SCORE=0.80
CITATION_UNIQUENESS_MARGIN=0.08
CITATION_MAX_WINDOW_CHARS=600
CITATION_MAX_CANDIDATES_PER_SOURCE=128
RAG_QUIZ_MIN_USEFUL_CHARS=100
RAG_DEBUG_API_KEY=
QUERY_EMBEDDING_CACHE_SIZE=512
RETRIEVAL_CACHE_SIZE=512
RETRIEVAL_CACHE_TTL_SECONDS=60

# Local development giữ SQLite. Production dùng Neon pooled URL dạng
# postgresql+psycopg://...-pooler.../dbname?sslmode=require
DATABASE_URL=sqlite:///data/rag.db
DATABASE_POOL_SIZE=4
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=300
DATABASE_CONNECT_TIMEOUT_SECONDS=10
USER_UPLOAD_DIR=data/uploads/users
USER_INDEX_DIR=data/indexes/users
MAX_UPLOAD_SIZE_MB=20
MAX_DOCUMENTS_PER_USER=100
MAX_STORAGE_MB_PER_USER=500
