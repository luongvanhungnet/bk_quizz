# Development uses /api through the Vite proxy. Cloudflare Pages must override
# VITE_API_BASE_URL with the full HTTPS Cloud Run URL plus /api.
VITE_API_BASE_URL=/api
VITE_DEV_API_TARGET=http://localhost:8080
# Set true only when a real same-origin reverse proxy handles /api in production.
VITE_API_SAME_ORIGIN_PROXY=false
