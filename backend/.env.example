PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/bkquiz
DATABASE_USERNAME=bkquiz
DATABASE_PASSWORD=change_me
# Use the schema owner for Flyway; the application continues using DATABASE_USERNAME.
DATABASE_MIGRATION_USERNAME=bkquizadmin
DATABASE_MIGRATION_PASSWORD=change_me
FRONTEND_ORIGINS=http://localhost:5173

JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_SECURE=false
BCRYPT_STRENGTH=12

AI_ENABLED=true
AI_CHAT_PROVIDER=google-genai
GEMINI_API_KEY=replace_with_google_ai_key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_TIMEOUT=60s
QUIZ_BATCH_MAX_QUESTIONS=20
QUIZ_BATCH_MAX_ATTEMPTS=3
QUIZ_BATCH_RETRY_DELAY=5m
QUIZ_BATCH_SUCCESS_DELAY=15s

# Backend là client duy nhất của RAG; phải trùng SPRING_BOOT_INTERNAL_API_KEY bên rag-service.
RAG_ENABLED=true
RAG_SERVICE_URL=http://127.0.0.1:8090
RAG_IAM_ENABLED=false
RAG_IAM_AUDIENCE=
RAG_INTERNAL_API_KEY=replace_with_same_internal_key
RAG_CONNECT_TIMEOUT=5s
RAG_READ_TIMEOUT=120s
RAG_HEALTH_POLL_DELAY=10s
DATABASE_POOL_SIZE=6
DATABASE_MIN_IDLE=1
DATABASE_JDBC_BATCH_SIZE=50
DATABASE_SLOW_QUERY_MS=300
JOB_POLL_DELAY=2s

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=replace_me
S3_BUCKET=bkquiz
S3_PATH_STYLE=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_ENABLED=false

RESEND_API_TOKEN=re_replace_with_resend_api_key
RESEND_API_URL=https://api.resend.com/emails
RESEND_CONNECT_TIMEOUT=30s
RESEND_READ_TIMEOUT=45s
RESEND_NETWORK_RETRY_DELAY=30s
APP_MAIL_FROM=BKQuiz <no-reply@your-verified-domain.example>
WORKER_ENABLED=true
JOB_WORKER_HEARTBEAT_DELAY=10s

# Chỉ bật cho lệnh bootstrap một lần, sau đó tắt ngay.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_USER_ID=

# Anti-abuse. Production should keep ANTI_ABUSE_ENABLED=true and store secrets in Secret Manager.
ANTI_ABUSE_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT=2s
REDIS_COMMAND_TIMEOUT=2s
ANTI_ABUSE_IP_HASH_SECRET=replace_with_at_least_32_random_characters
ANTI_ABUSE_RATE_WINDOW=1h
ANTI_ABUSE_USER_RATE_LIMIT=20
ANTI_ABUSE_IP_RATE_LIMIT=40
ANTI_ABUSE_DEVICE_RATE_LIMIT=30
AI_CONCURRENCY_TTL=30m
AI_COST_KEY_TTL=3d
AI_DEFAULT_INPUT_COST_PER_MILLION=0.10
AI_DEFAULT_OUTPUT_COST_PER_MILLION=0.40
AI_ESTIMATED_INPUT_TOKENS_PER_QUESTION=900
AI_ESTIMATED_OUTPUT_TOKENS_PER_QUESTION=500
AI_TRUSTED_DAILY_QUOTA=100
AI_NORMAL_DAILY_QUOTA=40
AI_CAUTION_DAILY_QUOTA=15
AI_RESTRICTED_DAILY_QUOTA=3
AI_TRUSTED_DAILY_COST_BUDGET=2.00
AI_NORMAL_DAILY_COST_BUDGET=0.80
AI_CAUTION_DAILY_COST_BUDGET=0.30
AI_RESTRICTED_DAILY_COST_BUDGET=0.08
AI_TRUSTED_CONCURRENCY=3
AI_NORMAL_CONCURRENCY=2
AI_CAUTION_CONCURRENCY=1
AI_RESTRICTED_CONCURRENCY=1
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
RISK_VERIFIED_EMAIL_TRUST=15
RISK_NORMAL_ACTIVITY_TRUST=3
RISK_SUCCESSFUL_SESSION_TRUST=1
RISK_ACCOUNT_AGE_TRUST_PER_DAY=0.10
RISK_ACCOUNT_AGE_TRUST_CAP=10
RISK_TRUSTED_MIN_SCORE=75
RISK_TRUSTED_MIN_LEGITIMATE_ACTIVITIES=10
RISK_CAUTION_SCORE=0.30
RISK_RESTRICTED_SCORE=0.60
RISK_BLOCKED_SCORE=0.90
# Administrative analytics projections (UTC, idempotently recomputed)
ANALYTICS_AGGREGATION_ENABLED=true
ANALYTICS_AGGREGATION_DELAY=5m
ANALYTICS_MAX_RANGE_DAYS=366
