PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/bkquiz
DATABASE_USERNAME=bkquiz
DATABASE_PASSWORD=change_me
# Use the schema owner for Flyway; the application continues using DATABASE_USERNAME.
DATABASE_MIGRATION_USERNAME=bkquizadmin
DATABASE_MIGRATION_PASSWORD=change_me
FRONTEND_ORIGINS=http://localhost:5173

JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_SECURE=false
BCRYPT_STRENGTH=12

AI_ENABLED=true
AI_CHAT_PROVIDER=google-genai
GEMINI_API_KEY=replace_with_google_ai_key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_TIMEOUT=60s

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=replace_me
S3_BUCKET=bkquiz
S3_PATH_STYLE=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_ENABLED=false

RESEND_API_KEY=re_replace_with_resend_api_key
RESEND_API_URL=https://api.resend.com/emails
RESEND_CONNECT_TIMEOUT=10s
RESEND_READ_TIMEOUT=15s
APP_MAIL_FROM=BKQuiz <no-reply@your-verified-domain.example>
WORKER_ENABLED=true

# Chỉ bật cho lệnh bootstrap một lần, sau đó tắt ngay.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_USERNAME=BKQuiz Admin
ADMIN_BOOTSTRAP_PASSWORD=replace_with_strong_password
